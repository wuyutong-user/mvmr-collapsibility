# Shell examples: replace /path/to with your authorised input locations.
# ERACA_PACKAGE_ROOT is the application subdirectory of the extracted package.
export ERACA_PACKAGE_ROOT=/path/to/Supplementary_Code_1/application
export ERACA_CONTROLLED_ROOT=/path/to/controlled_data
export ERACA_CANDIDATE_DIR=/path/to/controlled_data/cov_data
export ERACA_BMI_GWAS=/path/to/controlled_data/exp_data/21001_irnt.gwas.imputed_v3.both_sexes.tsv.bgz
export ERACA_VARIANTS_RDATA=/path/to/controlled_data/variants1.Rdata
export ERACA_OUTCOME_DIR=/path/to/outcome_gwas
export ERACA_PLINK=/path/to/plink
export ERACA_LD_BFILE=/path/to/ld_reference/reference
export ERACA_OUTPUT_DIR=/path/to/new_run/ERACA_RESULT
# Supply the completed evidence register for an application rerun.
export ERACA_LITERATURE_EDGES=/path/to/literature_edge_evidence.csv
